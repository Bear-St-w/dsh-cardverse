{
  "name": "dsh-cardverse",
  "version": "0.8.3",
  "type": "module",
  "description": "CardVerse 卡片宇宙：把 DSH 的对话流变成可视化卡片工作区。首卡=群发悬赏大厅，每卡一个工作区/一个模型，对话轨迹自动滚动存档到 HTML 分片，127.0.0.1:5002 可回放。",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "Bear-St-w"
}
